DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/postmortem_ai
DATABASE_SSL_MODE=disable
GEMINI_API_KEY=your-real-gemini-api-key-here
GEMINI_MODEL=gemini-2.5-flash
SESSION_SECRET=generate-a-real-random-secret-e.g.-python3-c-"import secrets;print(secrets.token_hex(32))"
COOKIE_SECURE=false
CORS_ORIGINS=http://localhost:3000

# Who the invoice is from (proforma while a payment claim is pending, receipt
# once approved -- /invoice/{claim id}). A company outside India will not
# wire against an email; its finance team needs a document naming the
# seller. All optional: unset, the document uses FOUNDER_BANK_ACCOUNT_NAME
# and omits the address and tax-id lines.
SELLER_LEGAL_NAME=
SELLER_ADDRESS=
SELLER_TAX_ID=
